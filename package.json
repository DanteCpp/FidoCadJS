{
  "name": "fidocadts",
  "version": "0.1.0",
  "description": "FidoCadJ circuit schematic editor — TypeScript browser port",
  "author": "Dante Loi",
  "license": "GPL-3.0-or-later",
  "main": "desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/generate-sw-precache.mjs",
    "preview": "vite preview",
    "desktop:build": "tsc && vite build --config vite.config.desktop.ts",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:dev": "vite --config vite.config.desktop.ts",
    "desktop:shell": "FIDOCADJS_DEV_SERVER_URL=http://localhost:5173 electron .",
    "desktop:smoke": "npm run desktop:build && electron scripts/desktop-smoke.cjs test/export/fixtures/fcd/full-pattern.fcd",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:run",
    "lint": "eslint src/ test/ --ext .ts",
    "lint:fix": "eslint src/ test/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:coverage": "vitest run --coverage",
    "docs:tests": "node scripts/generate-tests-md.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.8.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^1.6.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^17.0.4",
    "mathjax-full": "^3.2.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
